# Patchwork Configuration Environment Variables

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_NAME="Patchwork Self-Healing CI"
# First account is the administrator. Keep this false to stop new signups.
ALLOW_REGISTRATION=false

# Public webhook URL (optional; can also be set from Settings in the UI)
PUBLIC_WEBHOOK_URL=

# GitHub App Configuration (optional for local mock runs, required for real GitHub App)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=patchwork_secret_token
GITHUB_TOKEN=

# AI LLM Provider ("gemini", "openai", or "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-1.5-pro"

# Queue & Database Persistence
REDIS_URL="memory"
DATABASE_URL="sqlite+aiosqlite:///./patchwork.db"

# Ephemeral Docker Sandbox
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT="512m"
SANDBOX_CPU_LIMIT=0.5
SANDBOX_NETWORK_DISABLED=true
USE_DOCKER_SANDBOX=true

# Industry-Grade Guardrails
MAX_RETRY_ATTEMPTS=3
MAX_DIFF_LINES=30
LOOP_PREVENTION_PREFIX="ai-fix/"
